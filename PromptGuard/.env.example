# Environment overrides for PromptGuard
# Copy this file to .env and adjust paths as needed.

# ── Dataset paths ─────────────────────────────────────────────────────────────
# Default: ../PromptGuard/Dataset/PromptGuard_Dataset_FINAL.json
# RAW_DATASET_PATH=C:/path/to/PromptGuard_Dataset_FINAL.json

# Default: data/processed/cleaned_dataset.jsonl
# PROCESSED_DATASET_PATH=data/processed/cleaned_dataset.jsonl

# ── Logging ───────────────────────────────────────────────────────────────────
# Default: logs/promptguard.log
# LOG_FILE_PATH=logs/promptguard.log
